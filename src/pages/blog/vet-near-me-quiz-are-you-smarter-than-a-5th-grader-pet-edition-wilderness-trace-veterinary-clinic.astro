ault();\n      body.classList.remove('offcanvas-init');\n    });\n  }\n  // Offcanvas mobile submenu toggles\n  document.querySelectorAll('.offcanvas-menu .menu-parent > a, .offcanvas-menu .menu-parent > .menu-separator').forEach(function(el) {\n    var togglerSpan = document.createElement('span');\n    togglerSpan.className = 'menu-toggler';\n    togglerSpan.setAttribute('aria-label', 'Toggle submenu');\n    el.appendChild(togglerSpan);\n    togglerSpan.addEventListener('click', function(e) {\n      e.preventDefault();\n      e.stopPropagation();\n      var parent = el.closest('.menu-parent');\n      if (parent) parent.classList.toggle('menu-parent-open');\n    });\n  });\n\n  // 2. Sticky Header on scroll (matches Helix Ultimate sticky header behavior)\n  var header = document.getElementById('sp-header');\n  if (header) {\n    window.addEventListener('scroll', function() {\n      if (window.scrollY > 100) {\n        header.classList.add('header-sticky');\n      } else {\n        header.classList.remove('header-sticky');\n      }\n    }, { passive: true });\n  }\n\n  // 3. Home Hero 4-Slide Crossfade Slider (replaces SmartSlider3 + jQuery runtime)\n  var slides = document.querySelectorAll('.wtvc-hero-slide');\n  if (slides.length > 1) {\n    var currentSlide = 0;\n    var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n    if (!prefersReduced) {\n      setInterval(function() {\n        slides[currentSlide].classList.remove('is-active');\n        currentSlide = (currentSlide + 1) % slides.length;\n        slides[currentSlide].classList.add('is-active');\n      }, 5000);\n    }\n  }\n})();\n</script>\n</body>\n</html>";
